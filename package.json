{
  "name": "infraportal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "stripe:setup-links": "node ./scripts/setup-stripe-payment-links.mjs",
    "sync-specs": "node ./scripts/sync-api-specs.mjs",
    "check-spec-drift": "node ./scripts/check-spec-drift.mjs",
    "check-test-discovery": "node ./scripts/check-test-discovery.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --reporter=default --reporter=json --outputFile.json=./test-report.json"
  },
  "dependencies": {
    "dompurify": "^3.4.13",
