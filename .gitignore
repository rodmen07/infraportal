# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment and local secrets
.env
.env.*
!.env.example

# Tool caches
.cache/
.vite/
.eslintcache
coverage/

# vitest's JSON report, written by `npm run test:coverage` and read by
# `npm run check-test-discovery` (COVERAGE-UNDERRUN-1). It must never be
# committed: a stale report on disk is exactly what would let the discovery
# gate pass vacuously, which is the failure it exists to catch.
test-report.json

# Editor crash-recovery / temp files
*.tmp
*.tmp.*
*.bak
*.orig

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude Code session/local config (never versioned)
.claude/

# Vitest writes a transient config timestamp file next to vitest.config.ts
# when a run is interrupted; it is pure build debris.
vitest.config.ts.timestamp-*.mjs
